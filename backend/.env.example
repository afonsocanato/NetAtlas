PORT=4000
OFFLINE_AFTER_MISSED_REPORTS=2
CORS_ORIGIN=http://localhost:5173

# --- Supabase (required) ---
# From your Supabase project: Settings -> API.
# SERVICE ROLE key, not the anon/public one — it bypasses Row Level Security,
# which is fine here since only this trusted server ever uses it (the
# frontend and agent never talk to Supabase directly). Never expose it to
# the frontend or commit it.
# Run backend/supabase/schema.sql once in the project's SQL Editor before
# starting the backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth & secrets ---
# All of these are OPTIONAL: leave them unset and the backend auto-generates
# a random agent API key + JWT secret on first boot (persisted in Supabase),
# and a random admin login (printed once to the server log). Set them here
# only to pin specific values, e.g. for a reproducible deploy.
# AGENT_API_KEY=
# JWT_SECRET=
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Disables login entirely — only for a fully trusted LAN-only setup, never
# when the backend is reachable from the public internet.
# NETATLAS_DISABLE_AUTH=false
